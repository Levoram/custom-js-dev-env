{
  "name": "custom-javascript-development-environment",
  "version": "1.0.2",
  "description": "Javascript Development Environment: Setup Development faster",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:vite start-mockapi",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "generate-mock-data": "node buildScripts/generateMockData.js",
    "prestart-mockapi": "npm run generate-mock-data",
    "start-mockapi": "json-server src/api/db.json --port 3005",
    "security-check": "npm audit --audit-level high",
    "clean": "rimraf dist"
  },
  "author": "Nico Kuechler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/Levoram/custom-js-dev-env"
  },
  "dependencies": {
    "custom-javascript-development-environment": "file:",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.8",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "browserslist": "^4.29.5",
    "caniuse-lite": "^1.0.30001826",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "espree": "^11.2.0",
    "jsdom": "^31.0.1",
    "json-schema-faker": "^0.6.4",
    "json-server": "1.0.0-beta.15",
    "npm-run-all": "4.1.5",
    "numeral": "2.0.6",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "url": "^0.11.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "browserslist": "> 0.25%, not dead",
  "engines": {
    "node": ">=22.12.0"
  }
}
